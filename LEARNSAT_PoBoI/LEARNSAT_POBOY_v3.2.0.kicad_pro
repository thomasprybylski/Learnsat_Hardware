    "SPICEMODELCACHEKMHHWGDA": "<root>\r\n  <DocumentId>KMHHWGDA</DocumentId>\r\n  <CacheFrame Number=\"0\">\r\n    <Model Name=\"lm317\" Kind=\"CKT\">\r\n      <Text>*-------------------------------------------------\r\n* POSITIVE ADJUSTABLE VOLTAGE REGULATOR\r\n.SUBCKT LM317 IN ADJ OUT\r\nJADJ IN ADJ ADJ JADJMOD\t\r\nVREF 4 ADJ 1.250\r\nDBK IN 13 DMOD\r\nCBC 13 15 800.0E-12\r\nRBC 15 5 1.000E3\r\nQPASS 13 5 OUT QPASSMOD\r\nRB1 7 6 1\r\nRB2 6 5 128.3\r\nDSC 6 11 DMOD\r\nESC 11 OUT VALUE={5.646-.6667*V(6,5)*V(13,5)}\r\nDFB 6 12 DMOD\r\nEFB 12 OUT VALUE={8.822-.4024*V(13,5)+5.250E-3*V(13,5)*V(13,5) -.6667*V(13,5)*V(6,5)}\r\nEB 7 OUT 8 OUT 6.939\r\nRP 9 8 100\r\nCPZ 10 OUT 3.183E-6\r\nDPU 10 OUT DMOD\t\r\nRZ 8 10 .1\r\nEP 9 OUT 4 OUT 100\r\nRI OUT 4 100MEG\r\n.MODEL QPASSMOD NPN (IS=30F BF=50 VAF=1.500 NF=1.701)\r\n.MODEL JADJMOD NJF (BETA=50.00E-6 VTO=-1)\r\n.MODEL DMOD D (IS=30F N=1.701)\r\n.ENDS</Text>\r\n    </Model>\r\n  </CacheFrame>\r\n</root>",
    "SPICEMODELCACHEVYLUUOOD": "<root>\r\n  <DocumentId>VYLUUOOD</DocumentId>\r\n  <CacheFrame Number=\"0\">\r\n    <Model Name=\"lm317\" Kind=\"CKT\">\r\n      <Text>*-------------------------------------------------\r\n* POSITIVE ADJUSTABLE VOLTAGE REGULATOR\r\n.SUBCKT LM317 IN ADJ OUT\r\nJADJ IN ADJ ADJ JADJMOD\t\r\nVREF 4 ADJ 1.250\r\nDBK IN 13 DMOD\r\nCBC 13 15 800.0E-12\r\nRBC 15 5 1.000E3\r\nQPASS 13 5 OUT QPASSMOD\r\nRB1 7 6 1\r\nRB2 6 5 128.3\r\nDSC 6 11 DMOD\r\nESC 11 OUT VALUE={5.646-.6667*V(6,5)*V(13,5)}\r\nDFB 6 12 DMOD\r\nEFB 12 OUT VALUE={8.822-.4024*V(13,5)+5.250E-3*V(13,5)*V(13,5) -.6667*V(13,5)*V(6,5)}\r\nEB 7 OUT 8 OUT 6.939\r\nRP 9 8 100\r\nCPZ 10 OUT 3.183E-6\r\nDPU 10 OUT DMOD\t\r\nRZ 8 10 .1\r\nEP 9 OUT 4 OUT 100\r\nRI OUT 4 100MEG\r\n.MODEL QPASSMOD NPN (IS=30F BF=50 VAF=1.500 NF=1.701)\r\n.MODEL JADJMOD NJF (BETA=50.00E-6 VTO=-1)\r\n.MODEL DMOD D (IS=30F N=1.701)\r\n.ENDS</Text>\r\n    </Model>\r\n  </CacheFrame>\r\n</root>"
